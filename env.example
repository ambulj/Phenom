# ========================================================
# Phenom Desktop Assistant - Environment Configuration Example
# Copy this template to .env and insert your personal API keys
# ========================================================

# Sarvam AI Cloud TTS (Bulbul v4-flash - Kabir Voice)
SARVAM_API_KEY=

# NVIDIA Cloud Inference (Optional - Nemotron 70B/405B escalation)
NVIDIA_API_KEY=

# Telegram Bot Remote Companion (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=

# Google Workspace (Optional - Gmail & Calendar)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
GOOGLE_CALENDAR_TOKEN=

# System Setup State
PHENOM_FIRST_RUN_DONE=true
